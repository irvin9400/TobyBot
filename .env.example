# Discord bot
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
# Optional: set this while testing so commands register instantly to one server.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
GUILD_ID=

# Channel Discord kick/ban/timeout/role/nickname/warn commands log to
MOD_LOG_CHANNEL_ID=

# Channel in-game actions (from Roblox) log to
GAME_LOG_CHANNEL_ID=

# Role IDs allowed to use moderation commands (comma-separated). Leave blank
# to fall back to Discord's built-in permission checks per command instead.
MOD_ROLE_IDS=

# Webhook server (receives POST requests from your Roblox game)
WEBHOOK_PORT=3000
# Long random secret. Roblox sends this as: Authorization: Bearer <secret>
WEBHOOK_SECRET=change-me-to-something-long-and-random
